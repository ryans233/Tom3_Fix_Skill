# normalize line endings
* text=auto

# Windows scripts keep CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf

# docs / sources normalized to LF
*.c     text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.md    text eol=lf
*.ini   text eol=crlf

# binary
*.asi   binary
*.dll   binary
*.pdb   binary
*.obj   binary
